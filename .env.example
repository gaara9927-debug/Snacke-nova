# Environment variables example for Snacke LIVE
# Never commit real secret keys or .env to GitHub

# Port for Railway / local execution (defaults to 3000)
PORT=3000

# Secret key used between Termux (on POCO C65) and Railway Backend
TERMUX_WEBHOOK_SECRET=rainz878_snacke_secret_replace_me

# TikTok Username to track
TIKTOK_USERNAME=rainz878

# Node environment (production / development)
NODE_ENV=development
